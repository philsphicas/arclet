[Unit]
Description=Arc extension handler stubs
After=network.target
Before=extd.service

[Service]
Type=notify
NotifyAccess=all
ExecStart=/usr/local/bin/arc-extension-handler
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5s
RuntimeDirectory=arc-extension-handler
RuntimeDirectoryMode=0755
TimeoutStartSec=30s

[Install]
WantedBy=multi-user.target
RequiredBy=extd.service
